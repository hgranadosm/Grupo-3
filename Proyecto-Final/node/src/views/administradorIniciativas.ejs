<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Iniciativas</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <link rel="stylesheet"  href="css/administradorIniciativas.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap"
        rel="stylesheet">
</head>

<body>
        <!--MENU-->
    <header>
        <div class="contenedorHeader">
            <a href="./index.html" class="logoContentedor">
                <img class="isotipo" src="./img/isotipo.png" alt="isotipo">
                <img class="logo" src="./img/LogoMuni.png" alt="isologotipo">
            </a>
            <input type="checkbox" id="check">
            <label for="check" class="checkbtn">
                <i class="fa-solid fa-bars"></i>
            </label>
            <nav class="menuHeader opciones">
                <a class="menuEnlace" href="/paginaServicios">Servicios</a>
                <a class="menuEnlace" href="/iniciativas">Iniciativas</a>
                <a class="menuEnlace" href="/index">Noticias</a>
                <a class="menuEnlace" href="/avisos">Avisos</a>
                <a class="menuEnlace" href="/denuncias">Denuncias</a>
                <a class="menuIconoEnlace" href="/editarPerfil">
                    <i class="iconoMenu fa-solid fa-user"></i>                
                </a>
                <a class="boton" onclick="cerrarSesion()" >Cerrar sesión</a>
            </nav>
        </div>
    </header>

    <!--TABLA-->
    <h1 class="tituloTabla">Administración de Iniciativas</h1>
    <div class="contenedorTablaResponsive">
        <table class="contenedorTabla">
            <tr class="filas">
                <th class="titulosId">#</th>
                <th class="titulos nombreIniciativa">Nombre de la Iniciativa</th>
                <th class="titulos">Descripción</th>
                <th class="titulos usuarioPropuesta">Propuesto Por</th>
                <th class="titulos">Estado</th>
                <th class="titulos">Acciones</th>
            </tr>

            <% iniciativas.forEach((item, index) => { %>
                <tr>
                    <td class="descripcion"><%= index + 1 %></td>
                    <td class="descripcion"><%= item.titulo %></td>
                    <td class="descripcion"><%= item.descripcion %></td>
                    <td class="descripcion"><%= item.nombre %></td>
                    <td class="status">
                        <p class="<%= item.estado === 'Aprobada' ? 'aprobado' : (item.estado === 'Rechazada' ? 'rechazado' : '') %>">
                        <%= item.estado %>
                        </p>
                    </td>
                    <td class="contenedorBotones">
                        <% if (item.estado !== 'Aprobada') { %>
                            <button 
                                class="boton1 <%= item.estado !== 'Pendiente' ? 'w-100' : '' %>" 
                                onclick="actualizarEstado('<%= item._id %>', 'Aprobada')">
                                Aprobar
                            </button>
                        <% } %>
                        <% if (item.estado !== 'Rechazada') { %>
                            <button 
                                class="boton2 <%= item.estado !== 'Pendiente' ? 'w-100' : '' %>" 
                                onclick="actualizarEstado('<%= item._id %>', 'Rechazada')">
                                Rechazar
                            </button>
                        <% } %>
                    </td>
                </tr>
            <% }) %>
    
            <tr>
                <td class="final" colspan="5">Fin de las iniciativas</td>
            </tr>
        </table>
    </div>



    <!--FOOTER-->
    <footer>
        <div class="contenedorFooter">
            <div class="primeraColumnaFooter">
                <img class="footerLogo" src="./img/LogoMuniBlanco.png" width="158px" alt="logo municipales">
            </div>
            <div class="footerColumna">
                <a href="/paginaServicios">Servicios</a>
                <a href="/administradorIniciativas">Iniciativas</a>
                <a href="/paginaNoticia2">Noticias</a>
                <a href="/formularioAvisosAdministrador">Avisos</a>
                <a href="/Denuncias">Denuncias</a>
            </div>
            <div class="footerColumna redesColumna">
                <a href="https://www.instagram.com/gobmontesdeoca/"><i class="fa-brands fa-instagram"></i></a>
                <a href="https://www.facebook.com/gobmontesdeoca/"><i class="fa-brands fa-facebook-f"></i></a>
                <a href="https://twitter.com/GobMontesDeOca"><i class="fa-brands fa-x-twitter"></i></a>
                <a href="https://www.youtube.com/channel/UCux4pfOGXArPst7ZyDjxpog"><i class="fa-brands fa-square-youtube fa-bounce"></i></a>
            </div>
        </div>
        <div class="copyRight">
            <p>Todos los derechos reservados Municipalidad de Montes de Oca</p>
        </div>
    </footer>

    <script src="js/administradorIniciativas.js"></script>
</body>

</html>